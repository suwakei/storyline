# storyline — 環境変数のひな形
#
# 使い方: このファイルを `.env` にコピーして値を埋める。
#   cp .env.example .env
# `.env` は .gitignore で除外される。値をコミットしないこと。
#
# 仕様の根拠: .claude/.company/planning/specs/2026-08-04-accounts-and-server-spec.md

# --- Google OAuth ---
# Google Cloud Console > 認証情報 > OAuth 2.0 クライアント ID (種類: ウェブアプリケーション)
# 承認済みのリダイレクト URI に以下の 2 つを登録する:
#   http://localhost:4000/api/auth/callback/google   ← dev は 4000 (package.json の "dev")
#   https://<本番ドメイン>/api/auth/callback/google
# 変数名は Auth.js v5 が自動認識する規約に合わせている (AUTH_<PROVIDER>_ID/SECRET)。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- セッションの署名鍵 ---
# 生成: openssl rand -base64 32
# 本番 (Vercel) にはローカルと別の値を設定してよい。
AUTH_SECRET=

# --- Postgres ---
# ローカル: リポジトリ同梱の docker-compose.yml を使う。
#   npm run db:up
#   DATABASE_URL=postgresql://storyline:storyline@localhost:5430/storyline?schema=public
#   ホスト側ポートが 5430 なのは、他プロジェクトの DB コンテナと並列で動かすため。
#   よく使われる 5432 / 5433 は既に別プロジェクトが使っている。
# 本番: Neon (Vercel Marketplace 経由で連携すると Vercel 側に自動で入る)。
DATABASE_URL=

# --- Vercel Blob ---
# シーンのサムネイル置き場。Vercel でストアを作ると発行される。
BLOB_READ_WRITE_TOKEN=

# --- 招待コード ---
# Google ログインは誰でも通れてしまうため、これが無料枠を守る防波堤になる。
# 初回サインイン (= 新規ユーザ作成) のときだけ必要。既存ユーザは入力不要。
# 未設定だと新規ユーザを作れない (フェイルセーフ)。
# 生成: LC_ALL=C tr -dc 'A-HJ-NP-Za-km-z2-9' </dev/urandom | head -c 12
AUTH_INVITE_CODE=
